{
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ishankabra.com" }],
      "destination": "https://ishankabra.com/:path*",
      "permanent": true
    },
    { "source": "/", "destination": "/wisprflow", "permanent": false }
  ]
}
